# Windy Point Forecast API key (https://api.windy.com/point-forecast)
# Keys from Map Forecast or Webcams do NOT work here — create a Point Forecast key.
WINDY_API_KEY=your_point_forecast_api_key_here

# Optional trails-mcp settings
# TRAILS_MCP_LOG_LEVEL=info
# TRAILS_MCP_USER_AGENT=trails-mcp/0.1.0 (your-contact)
