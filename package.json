{
  "name": "trails-mcp",
  "version": "0.1.0",
  "description": "Multi-service MCP server for outdoor/mapping data. Service 1: Waymarked Trails (hiking, cycling, mtb, riding, skating, slopes) + Nominatim geocoding.",
  "type": "module",
  "bin": {
    "trails-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "waymarkedtrails",
    "openstreetmap",
    "hiking",
    "trails"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
